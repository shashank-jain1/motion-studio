# Motion Studio API on a home machine, published by a Cloudflare Tunnel; the web app is static elsewhere (npm run build).
# install.sh copies this to ~/.config/motion-studio/server.env (edit there, then: systemctl --user restart motion-studio).
MOTION_STUDIO_MODE=hosted
MOTION_STUDIO_HOST=127.0.0.1
MOTION_STUDIO_PORT=4320
MOTION_STUDIO_PUBLIC_URL=https://motionstudio-api.theshashankjain.com
MOTION_STUDIO_WEB_ORIGIN=https://motionstudio.theshashankjain.com
MOTION_STUDIO_TRUST_PROXY=1
# closed: only the first account (you) can sign up. The director chat runs on this server's ANTHROPIC_API_KEY.
MOTION_STUDIO_SIGNUP=closed
MOTION_STUDIO_DATA=${HOME}/.local/share/motion-studio/data
MOTION_STUDIO_PROJECTS=${HOME}/.local/share/motion-studio/projects
MOTION_STUDIO_RENDER_CONCURRENCY=2
NODE_ENV=production
