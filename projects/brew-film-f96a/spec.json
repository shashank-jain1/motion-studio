{
  "title": "Brew — wake up to great coffee",
  "format": "9:16",
  "fps": 30,
  "style": "editorial",
  "bpm": 120,
  "theme": {
    "fonts": {
      "display": "Bricolage Grotesque",
      "body": "Inter"
    },
    "colors": {
      "bg": "#d8d4cf",
      "fg": "#2b1a12",
      "muted": "#6d6862",
      "accent": "#e8743b",
      "accent2": "#f2b25c",
      "card": "#fff4e6"
