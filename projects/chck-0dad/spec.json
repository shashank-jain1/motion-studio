{
  "title": "Halo — focus, beautifully",
  "fps": 30,
  "style": "minimal-dark",
  "formats": [
    "16:9",
    "1:1",
    "4:5"
  ],
  "sound": {
    "palette": "tech",
    "intensity": 0.6
  },
  "theme": {
    "fonts": {
      "display": "Sora",
      "body": "Inter"
    },
    "colors": {
      "bg": "#0b0a14",
      "fg": "#f4f2ff",
      "muted": "#8f8aa8",
      "accent": "#7c5cff",
      "accent2": "#3ee0c5",
      "card": "#16142a",
      "lilac": "#efeaff",
      "ink": "#0b0a14"
    }
  },
  "fx": {
    "grain": 0.07,
    "vignette": 0.35
  },
  "concept": {
    "truth": "Halo helps busy people focus on one thing at a time, feeling calm.",
    "metaphor": "fusion — the noise of a hundred pings collapses into one calm violet dot, and the dot IS the app icon",
    "motif": "one violet dot (actor) that survives every cut and becomes the icon",
    "verb": "clarify (many → one)",
    "hook": "notifications rain in while a counter ticks to 127 — before lunch",
    "arc": [
      "hook: 127 pings before lunch",
      "tension: the noise piles up",
      "transformation: everything collapses into one dot",
      "proof: the dot is the focus timer in the app",
      "lockup: the dot becomes the icon"
    ],
    "colorScript": [
      "ink + grey noise",
      "ink → violet",
      "lilac calm",
      "ink + violet lockup"
    ],
    "niche": "app",
    "story": {
      "insight": "Nobody chooses distraction; it arrives one ping at a time.",
      "audienceTension": "I want deep work, but I'm afraid to miss something.",
      "inherentDrama": "the moment every notification goes quiet at once",
      "orthodoxy": [
        "a phone spinning in space",
        "app icons raining down",
        "confetti on download",
        "'Download now' badges as the climax"
      ],
      "structure": "transformation",
      "clicheControl": {
        "obvious": "A phone spins in space while app icons rain down and confetti bursts: 'Download now'.",
        "banned": [
          "confetti",
          "spinning phone",
          "download now",
          "app store"
        ]
      },
      "beats": [
        {
          "t": 0,
          "beat": "hook",
          "emotion": "overwhelm",
          "intensity": 7,
          "sound": "notification pops + counter ticks"
        },
        {
          "t": 1.8,
          "beat": "tension",
          "emotion": "overwhelm",
          "intensity": 7,
          "to": 8,
          "sound": "zoom-into whoosh"
        },
        {
          "t": 2.6,
          "beat": "release",
          "emotion": "relief",
          "intensity": 5,
          "sound": "noise drops out"
        },
        {
          "t": 3.8,
          "beat": "proof",
          "emotion": "calm control",
          "intensity": 6,
          "to": 7
        },
        {
          "t": 7,
          "beat": "hold",
          "emotion": "anticipation",
          "intensity": 5
        },
        {
          "t": 7.7,
          "beat": "peak",
          "emotion": "delight",
          "intensity": 9,
          "wow": "the calm violet dot snaps into the Halo icon as the wordmark cascades (camera punch + sparkles)",
          "sound": "auto chime on the logo reveal"
        },
        {
          "t": 8.3,
          "beat": "lock",
          "emotion": "calm",
          "intensity": 8
        }
      ],
      "peakAt": 7.7,
      "mnemonic": {
        "visual": "the violet dot becomes the app icon",
        "sonic": "tech-palette chime on the logo reveal (auto sound)"
      }
    }
  },
  "actors": [
    {
      "id": "dot",
      "from": "noise",
      "until": "lockup",
      "layer": {
        "type": "morph",
        "width": 300,
        "height": 300,
        "inertia": true,
        "enter": {
          "type": "grow",
          "duration": 0.5
        },
        "shapes": [
          {
            "at": 0,
            "shape": "circle",
            "fill": "$accent"
          },
          {
            "at": 7.8,
            "shape": "svg:assets/halo-logo.svg#icon",
            "morph": 0.9,
            "twist": 20
          }
        ]
      },
      "poses": [
        {
          "scene": "noise",
          "t": 0,
          "x": 0,
          "y": -520,
          "scale": 0.28
        },
        {
          "scene": "collapse",
          "t": 0.7,
          "x": 0,
          "y": -210,
          "scale": 1.1,
          "move": 0.7,
          "ease": "expoOut"
