  "concept": {
    "truth": "DevFest Bhopal helps Central India's developers build together, feeling like they belong to something that keeps going",
    "metaphor": "the full stop of 'Bhopal BUILDS.' is the community: it never actually stops — it drags a member count, picks a track, stamps every pillar and dates the day, then comes home (replacement)",
    "motif": "the red full stop",
    "verb": "gather",
    "hook": "a cursor clicks the full stop of 'BUILDS.' and it jumps out of the word",
    "arc": [
      "hook: the full stop is clickable",
      "proof: 8,720 builders",
      "choice: two tracks",
      "range: five pillars",
      "the date",
      "peak: the whole map at once",
      "lock: back in BUILDS."
    ],
