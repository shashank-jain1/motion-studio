          "height": 820,
          "y": -40,
          "strokeWidth": 14,
          "gradient": [
            "#4cc9ff",
            "#19e6a1"
          ],
          "glow": true,
          "drawDuration": 1.9,
          "ease": "inOut"
        },
        {
          "type": "card",
          "variant": "stat",
          "icon": "📈",
          "title": "+8.4%",
          "body": "this year",
          "meta": "▲ 2.1%",
          "accent": "$accent",
          "fontSize": 30,
          "x": -230,
          "y": -380,
          "start": 0.8,
          "enter": {
            "type": "pop",
            "duration": 0.45
          },
          "inertia": true
        },
        {
          "type": "card",
          "variant": "glass",
          "icon": "🪙",
          "title": "Round-ups",
          "body": "$4.20 a day, invested",
          "width": 560,
          "fontSize": 30,
          "x": 140,
          "y": 330,
          "start": 1.2,
          "enter": {
            "type": "rise",
            "duration": 0.5
          }
        },
        {
          "type": "text",
          "text": "Every round-up,\ncompounding.",
          "preset": "mask-up",
          "fontSize": 96,
          "weight": 700,
          "color": "$fg",
          "y": 560,
          "start": 0.3,
          "highlight": {
            "words": [
              "compounding."
