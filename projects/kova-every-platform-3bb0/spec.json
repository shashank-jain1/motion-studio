          "y": -40,
          "enter": {
            "type": "pop",
            "duration": 0.35
          }
        },
        {
          "type": "text",
          "text": "saved without thinking.",
          "preset": "blur-rise",
          "fontSize": 68,
          "weight": 500,
          "font": "$body",
          "color": "$muted",
          "y": 110,
          "start": 0.45
        },
        {
          "type": "particles",
