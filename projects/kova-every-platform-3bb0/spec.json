{
  "title": "Kova — grow on autopilot",
  "fps": 30,
  "style": "minimal-dark",
  "formats": [
    "16:9",
    "1:1",
    "4:5"
  ],
  "sound": {
    "palette": "tech",
    "intensity": 0.55
  },
  "theme": {
    "fonts": {
      "display": "Space Grotesk",
      "body": "Inter"
    },
    "colors": {
      "bg": "#07131f",
      "fg": "#eafff6",
      "muted": "#7f97a8",
      "accent": "#19e6a1",
      "accent2": "#4cc9ff",
      "card": "#0e2233",
      "mint": "#e9fff6",
      "navy": "#07131f",
      "gold": "#ffd166"
    }
  },
  "fx": {
    "grain": 0.06,
    "vignette": 0.4
  },
  "concept": {
    "truth": "Kova helps young earners grow their savings automatically, feeling in control.",
    "metaphor": "fusion — one coin compounds: it climbs a rising line, locks into a shield, and its upward arrow becomes the logo",
    "motif": "a gold coin (actor) that becomes the logo's mint arrow-coin",
    "verb": "grow",
    "hook": "a balance counter slams from $0 to $12,480 as the coin drops",
    "arc": [
      "hook: $12,480 saved without thinking",
      "proof: every round-up climbs the curve",
      "trust: the coin locks into a shield",
      "lockup: the coin is the logo"
    ],
    "colorScript": [
      "navy + gold",
      "navy + mint glow",
      "mint relief",
      "navy lockup"
    ]
  },
  "actors": [
    {
      "id": "coin",
      "from": "hook",
      "until": "lockup",
      "layer": {
        "type": "morph",
        "width": 300,
        "height": 300,
        "inertia": true,
        "enter": {
          "type": "drop-in-3d",
          "duration": 0.55
        },
        "shapes": [
          {
            "at": 0,
            "shape": "coin",
            "fill": "$gold"
          },
          {
            "at": 4.8,
            "shape": "shield",
            "fill": "$accent",
            "morph": 0.7,
            "twist": 15
          },
          {
            "at": 7.8,
            "shape": "svg:assets/kova-logo.svg#icon",
            "morph": 0.9
          }
        ]
      },
      "poses": [
        {
          "scene": "hook",
          "t": 0,
          "x": 0,
          "y": -470,
          "scale": 0.9
        },
        {
          "scene": "grow",
          "t": 2.2,
          "x": 300,
          "y": -330,
          "scale": 0.42,
          "move": 1.6,
          "ease": "inOutQuint"
        },
        {
          "scene": "secure",
          "t": 0.5,
          "x": 0,
          "y": -230,
          "scale": 1.25,
          "move": 0.6,
          "ease": "expoOut"
        },
        {
          "scene": "lockup",
          "t": 0.9,
          "snapTo": "lockup-logo",
          "move": 0.9,
          "ease": "expoOut"
        }
      ]
    }
  ],
  "scenes": [
    {
      "id": "hook",
      "duration": 2.2,
      "background": [
        {
          "type": "solid",
          "color": "$navy"
        },
        {
          "type": "spotlight",
          "base": "transparent",
          "color": "#0f3a3a",
          "y": -300
        }
      ],
      "camera": {
        "keyframes": [
          {
            "t": 0,
            "zoom": 1
          },
          {
            "t": 2.2,
            "zoom": 1.06,
            "ease": "inOut"
          }
        ],
        "punch": [
          1.15
        ]
      },
      "layers": [
        {
          "type": "counter",
          "from": 0,
          "to": 12480,
          "prefix": "$",
          "countDuration": 1.1,
          "countDelay": 0.05,
          "ease": "outExpo",
          "fontSize": 200,
          "weight": 700,
          "gradient": [
            "#eafff6",
            "#19e6a1"
