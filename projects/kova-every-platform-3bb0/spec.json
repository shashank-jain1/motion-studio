        "punch": [
          0.9
        ]
      },
      "layers": [
        {
          "type": "logo",
          "id": "lockup-logo",
          "src": "assets/kova-logo.svg",
          "parts": "wordmark",
          "frame": "full",
          "mode": "cascade",
          "height": 170,
          "y": -160,
          "start": 0.7
        },
        {
          "type": "text",
          "text": "Grow on autopilot.",
          "preset": "blur-rise",
          "fontSize": 72,
          "weight": 600,
          "font": "$body",
          "color": "$fg",
          "y": 30,
          "start": 1.2
        },
        {
          "type": "card",
          "variant": "button",
          "title": "Open an account",
          "accent": "$accent",
          "color": "#07131f",
          "fontSize": 46,
          "y": 200,
          "start": 1.7,
          "press": 2.6,
          "enter": {
            "type": "grow",
            "duration": 0.5
          },
          "inertia": true
        },
        {
          "type": "text",
          "text": "Takes 2 minutes",
          "preset": "tracking",
          "fontSize": 34,
          "weight": 500,
          "font": "$body",
          "color": "$muted",
          "y": 320,
          "start": 2
        }
      ]
    }
  ],
  "format": "9:16"
}
