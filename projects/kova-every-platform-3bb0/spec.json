      "layers": [
        {
          "type": "shape",
          "shape": "ring",
          "width": 560,
          "height": 560,
          "stroke": "$accent",
          "strokeWidth": 4,
          "y": -230,
          "draw": true,
          "drawDuration": 1,
          "start": 0.4,
          "opacity": 0.7
        },
        {
          "type": "text",
          "text": "Locked down.\nAlways yours.",
          "preset": "slide-words",
          "fontSize": 104,
          "weight": 700,
          "color": "$navy",
          "y": 200,
          "start": 0.5
        },
        {
          "type": "card",
          "variant": "toast",
