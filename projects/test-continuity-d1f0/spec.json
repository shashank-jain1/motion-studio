{
  "format": "16:9",
  "style": "neon",
  "fps": 30,
  "bpm": 120,
  "beatOffset": 0,
  "theme": {
    "colors": {
      "bg": "#07060d",
      "fg": "#f4f1ff",
      "accent": "#ff3d7f",
      "accent2": "#7a5cff"
    }
  },
  "actors": [
    {
      "id": "dot",
      "layer": {
        "type": "shape",
        "shape": "circle",
        "width": 90,
        "color": "$accent",
        "glow": true,
        "enter": {
          "type": "pop",
          "duration": 0.5
        }
      },
      "poses": [
        {
          "scene": "intro",
          "t": 0,
          "x": 0,
          "y": -170,
          "scale": 1
        },
        {
          "scene": "intro",
          "t": 3,
          "x": 0,
          "y": -170,
          "scale": 1
        },
        {
          "scene": "drop",
          "t": 0.9,
          "x": -640,
          "y": -300,
          "scale": 0.6,
          "ease": "inOutExpo"
        },
        {
          "scene": "drop",
          "t": 3.266667,
          "x": -640,
          "y": -300,
          "scale": 0.6
        },
        {
          "scene": "echo",
          "t": 0.5,
          "x": 700,
          "y": 330,
          "scale": 0.35,
          "ease": "inOutQuint"
        }
      ],
      "until": "echo"
    },
    {
      "id": "seed",
      "layer": {
        "type": "morph",
        "width": 160,
        "height": 160,
        "fill": "#ffd23f",
        "shapes": [
          {
            "at": 0,
            "shape": "circle",
            "scale": 0.35
          },
          {
            "at": 4.5,
            "shape": "coin",
            "morph": 0.7,
            "twist": 90
          },
          {
            "at": 8,
            "shape": "star",
            "fill": "#ff3d7f",
            "morph": 0.8,
            "twist": -40
          }
        ]
      },
      "poses": [
        {
          "scene": "intro",
          "t": 0,
          "x": -640,
          "y": 300,
          "scale": 0.8
        },
        {
          "scene": "drop",
          "t": 1.266667,
          "x": 620,
          "y": -260,
          "scale": 1,
          "ease": "inOutExpo"
        },
        {
          "scene": "echo",
          "t": 1,
          "x": -700,
          "y": -330,
          "scale": 0.7,
          "rotate": 15,
          "ease": "inOutQuint"
        }
      ],
      "until": "slice"
    }
  ],
  "scenes": [
    {
      "id": "intro",
      "duration": 4,
      "background": {
        "type": "spotlight",
        "base": "#07060d",
        "color": "#2a1440"
      },
      "camera": {
        "punch": [
          2
        ]
      },
      "layers": [
        {
          "type": "text",
          "text": "Make it faster",
          "preset": "slot",
          "swap": {
            "words": [
              "simpler",
              "louder",
              "yours"
            ],
            "every": 0.6
          },
          "fontSize": 140,
          "y": 90,
          "weight": 800,
          "start": 0.5
        }
      ]
    },
    {
      "id": "drop",
      "duration": 4.766667,
      "transition": {
        "type": "expand",
        "from": "dot",
        "color": "$accent2",
        "duration": 0.75
      },
      "background": {
        "type": "solid",
        "color": "#160b2e"
      },
      "layers": [
        {
          "type": "text",
          "text": "DROP IT",
          "preset": "physics",
          "fontSize": 200,
          "weight": 900,
          "y": -40,
          "start": 1.266667
        },
        {
          "type": "text",
          "text": "into the third dimension",
          "preset": "cascade-3d",
          "fontSize": 64,
          "y": 150,
          "start": 2.266667,
          "weight": 600
        },
        {
          "id": "hole",
          "type": "shape",
          "shape": "circle",
          "width": 70,
          "color": "#ffd23f",
          "x": 520,
          "y": 260,
          "start": 2.766667,
          "enter": {
            "type": "pop",
            "delay": 0,
            "duration": 0.4
          }
        }
      ]
    },
    {
      "id": "echo",
      "duration": 4.5,
      "transition": {
        "type": "zoom-into",
        "from": "hole",
        "duration": 1
      },
      "background": {
        "type": "gradient",
        "colors": [
          "#0b2a4a",
          "#071423"
        ],
        "angle": 160
      },
      "layers": [
        {
          "type": "text",
          "text": "REPEAT",
          "preset": "echo",
          "fontSize": 150,
          "weight": 900,
          "echoCount": 7,
          "start": 1.5
        }
      ]
    },
    {
      "id": "slice",
      "duration": 4,
      "transition": {
        "type": "slice",
        "duration": 0.75,
        "slices": 6
      },
      "background": {
        "type": "solid",
        "color": "#1b0710"
      },
      "layers": [
        {
          "type": "text",
          "text": "CUT CLEAN",
          "preset": "slice",
          "fontSize": 190,
          "weight": 900,
          "y": -90,
          "start": 1.766667
        },
        {
          "type": "text",
          "text": "weight that breathes",
          "preset": "weight-wave",
          "fontSize": 90,
          "y": 130,
          "weight": 500,
          "start": 2.266667
        }
      ]
    },
    {
      "id": "fill",
      "duration": 5,
      "transition": {
        "type": "match"
      },
      "background": {
        "type": "solid",
        "color": "#07060d"
      },
      "layers": [
        {
          "type": "text",
          "text": "COLOR",
          "preset": "mask-up",
          "fill": "assets/fillimg.jpg",
          "fontSize": 300,
          "weight": 900,
          "y": -150
        },
        {
          "type": "text",
          "text": "MOTION",
          "preset": "blur-rise",
          "fill": "assets/fillvid.mp4",
          "fontSize": 260,
          "weight": 900,
          "y": 170,
          "start": 0.3
        },
        {
          "id": "chip",
          "type": "shape",
          "shape": "rect",
          "width": 260,
          "height": 96,
          "radius": 48,
          "color": "#ffd23f",
          "x": 620,
          "y": 420,
          "start": 2.266667,
          "enter": {
            "type": "pop",
            "duration": 0.4
          }
        }
      ]
    },
    {
      "id": "outro",
      "duration": 3,
      "transition": {
        "type": "expand",
        "from": "chip",
        "shape": "rounded",
        "duration": 1
      },
      "background": {
        "type": "solid",
        "color": "#ffd23f"
      },
      "layers": [
        {
          "type": "text",
          "text": "Ship it.",
          "preset": "cascade-3d",
          "fontSize": 220,
          "weight": 900,
          "color": "#07060d",
          "start": 0.4
        }
      ]
    }
  ]
}
