    "verb": "clarify (blur → sharp)",
    "hook": "grey weekend dates whip past smeared on every kick; crisp over them: 'Most nights blur.'",
    "arc": [
      "hook: most nights blur",
      "tension: the dates accelerate to half-beats",
      "stopdown: black, the blurred ring alone",
      "wow: the drop — the ring snaps sharp, SAT 10.24 lands",
      "lockup: the ring is the logo + tickets"
    ],
    "colorScript": [
      "black + smeared grey, magenta only as a blur",
      "grey stream accelerating",
      "black hold",
      "magenta flash, everything sharp",
      "black lockup"
    ],
