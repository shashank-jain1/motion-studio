# Motion Studio environment. Copy to .env (git-ignored) and fill in what you use.
# Loaded at startup by the web server, the MCP server and the CLI (src/core/env.ts).
# Variables already set in your shell always take priority over this file.

# --- Gemini (optional, free tier): voiceovers + cloud transcription -----------------------------
# Free key: https://aistudio.google.com/apikey  ·  Free-tier requests may be used by Google to improve its products.
GEMINI_API_KEY=

# --- Director (in-app chat) --------------------------------------------------------------------
# Or paste it in the studio's Settings. Leave empty if you use `ant auth login` or Settings.
ANTHROPIC_API_KEY=

# --- Local speech / rendering (defaults shown) -------------------------------------------------
# MOTION_STUDIO_WHISPER_MODEL=base        # tiny | base | small | medium | large-v3-turbo (*.en = English-only, faster)
# MOTION_STUDIO_GL=angle                  # swangle if WebGL shaders fail on a machine without a GPU

# --- Server ------------------------------------------------------------------------------------
# MOTION_STUDIO_PORT=4310
# MOTION_STUDIO_MODE=local                # hosted = accounts + per-user projects (see docs/PLATFORM.md)
# MOTION_STUDIO_PUBLIC_URL=               # e.g. https://studio.example.com (hosted mode)
# MOTION_STUDIO_WEB_ORIGIN=               # web app on another host, same site (docs/DEPLOY.md, static frontend)

# --- AWS Lambda rendering (optional, see docs/DEPLOY.md) -----------------------------------------
# RENDER_BACKEND=local                    # lambda to render on AWS
# REMOTION_AWS_ACCESS_KEY_ID=
# REMOTION_AWS_SECRET_ACCESS_KEY=
# REMOTION_AWS_REGION=us-east-1
