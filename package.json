{
  "name": "motion-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-directed motion graphics engine on Remotion, driven over MCP.",
  "scripts": {
    "studio": "remotion studio src/engine/index.ts --public-dir=projects",
    "mcp": "tsx src/mcp/server.ts",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "server": "tsx src/server/index.ts",
    "web": "vite --config web/vite.config.ts",
    "dev": "concurrently -k -n server,web -c blue,magenta \"pnpm server\" \"pnpm web\"",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "pnpm build:web && pnpm server",
    "deploy:lambda": "tsx scripts/deploy-lambda.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@codemirror/lang-json": "6.0.2",
    "@hono/node-server": "2.1.3",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@remotion/bundler": "4.0.532",
    "@remotion/cli": "4.0.532",
    "@remotion/google-fonts": "4.0.532",
    "@remotion/lambda": "4.0.532",
    "@remotion/lottie": "4.0.532",
    "@remotion/media-utils": "4.0.532",
    "@remotion/motion-blur": "4.0.532",
    "@remotion/noise": "4.0.532",
    "@remotion/paths": "4.0.532",
    "@remotion/player": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "@remotion/transitions": "4.0.532",
    "@uiw/react-codemirror": "4.25.12",
    "flubber": "0.4.2",
    "hono": "4.13.12",
    "lottie-web": "5.12.2",
    "opentype.js": "2.0.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.18.4",
    "remotion": "4.0.532",
    "svg-path-commander": "2.3.3",
    "svgpath": "2.6.0",
    "svgson": "5.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/flubber": "^0.4.0",
    "@types/node": "22.18.6",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  }
}